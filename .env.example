# The app reads these from the process environment. Defaults in code match the
# values below, so the API runs without setting anything.

# SQLAlchemy URL. SQLite file in the working directory by default.
DATABASE_URL="sqlite:///./expenses.db"

# Signs JWTs. The in-code default is for local use only: set a long random
# value anywhere the API is reachable by others.
SECRET_KEY="this_is_my_secret_key_change_later"

# Where uvicorn serves the API locally (docs at $BASE_URL/docs).
BASE_URL="http://127.0.0.1:8000"
